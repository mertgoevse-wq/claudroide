#!/usr/bin/env bash
# ==============================================================================
# ClauDroide Developer eXecutive (cdx) — Workflow-Automatisierung für Samsung A56
# ==============================================================================
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DOWNLOAD_DIR="/sdcard/Download"
GRADLE_JVM_ARGS="-Xmx1536m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"

# Farbige Terminal-Ausgabe
BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
RESET="\033[0m"

log_info()  { echo -e "${BLUE}[cdx]${RESET} $*"; }
log_ok()    { echo -e "${GREEN}[cdx:ok]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[cdx:warn]${RESET} $*"; }
log_err()   { echo -e "${RED}[cdx:error]${RESET} $*" >&2; }

# Sicherstellen, dass wir im Projekt-Root arbeiten
cd "${PROJECT_ROOT}"

usage() {
  cat << EOF
${BOLD}ClauDroide CLI (cdx) — Samsung Galaxy A56 Workflow${RESET}

Verwendung: cdx <Befehl> [Optionen]

Befehle:
  ${GREEN}status${RESET}                 Zeigt Git-, Hardware-, Build- und Toolchain-Status
  ${GREEN}build${RESET} [debug|release]  Baut APK mit A56-Speicherbegrenzung und kopiert nach /sdcard/Download
  ${GREEN}test${RESET} [fast|all|<query>] Führt Unit-Tests aus (fast = Kern-Suiten, all = 2600+ Tests)
  ${GREEN}check${RESET}                  Führt alle Qualitäts-Gates aus (Frontmatter-Sync, Secret-Gate, Git-Diff)
  ${GREEN}adb${RESET}                    Prüft ADB-Status und zeigt Verbindungshilfe für Wireless Debugging
  ${GREEN}install${RESET} [debug|release] Installiert die gebaute APK auf dem A56 (via ADB, falls verbunden)
  ${GREEN}clean${RESET}                  Stoppt hängende Gradle-Daemons und räumt temporäre Dateien auf
  ${GREEN}resume${RESET}                 Überprüft Checkpoint und gibt Empfehlung für nächsten Task

EOF
}

cmd_status() {
  echo -e "${BOLD}=== CLAUDROIDE UMGEBUNGS- & PROJEKTSTATUS ===${RESET}"
  echo -e "Projekt-Pfad: ${PROJECT_ROOT}"

  # Git
  local branch commit dirty
  branch=$(git branch --show-current 2>/dev/null || echo "unbekannt")
  commit=$(git log -1 --oneline 2>/dev/null || echo "kein commit")
  dirty=$(git status --short 2>/dev/null | wc -l | tr -d ' ')
  echo -e "Git-Branch:   ${GREEN}${branch}${RESET}"
  echo -e "Letzter Commit: ${commit}"
  echo -e "Ungespeicherte Änderungen: ${dirty} Datei(en)"

  # Toolchain
  echo -e "\n${BOLD}--- Toolchain (Galaxy A56 / PRoot Debian) ---${RESET}"
  echo -e "Java:         $(java -version 2>&1 | head -n 1)"
  echo -e "Android SDK:  ${ANDROID_HOME:-/home/mert/Android/Sdk}"

  if [ -x "/home/mert/droidroute/droidroute/tools/aapt2-aarch64/aapt2" ]; then
    echo -e "Native AAPT2: ${GREEN}aktiv (/home/mert/droidroute/droidroute/tools/aapt2-aarch64/aapt2)${RESET}"
  else
    echo -e "Native AAPT2: ${RED}NICHT GEFUNDEN!${RESET}"
  fi

  # Speicher
  echo -e "\n${BOLD}--- Ressourcen ---${RESET}"
  free -h 2>/dev/null | awk '/Mem:/ {print "RAM frei:      " $7 " von " $2}' || true
  df -h "${PROJECT_ROOT}" 2>/dev/null | awk 'NR==2 {print "Disk frei:     " $4 " von " $2 " (" $5 " belegt)"}' || true

  # APK Stand
  echo -e "\n${BOLD}--- Gebaute APKs ---${RESET}"
  if [ -f "app/build/outputs/apk/debug/app-debug.apk" ]; then
    local dsize dsha
    dsize=$(ls -lh app/build/outputs/apk/debug/app-debug.apk | awk '{print $5}')
    dsha=$(sha256sum app/build/outputs/apk/debug/app-debug.apk | awk '{print $1}')
    echo -e "Debug APK:   ${GREEN}${dsize}${RESET} (SHA-256: ${dsha:0:16}...)"
  else
    echo -e "Debug APK:   ${YELLOW}noch nicht gebaut${RESET}"
  fi

  if [ -f "app/build/outputs/apk/release/app-release.apk" ]; then
    local rsize rsha
    rsize=$(ls -lh app/build/outputs/apk/release/app-release.apk | awk '{print $5}')
    rsha=$(sha256sum app/build/outputs/apk/release/app-release.apk | awk '{print $1}')
    echo -e "Release APK: ${GREEN}${rsize}${RESET} (SHA-256: ${rsha:0:16}...)"
  else
    echo -e "Release APK: ${YELLOW}noch nicht gebaut${RESET}"
  fi

  # Download-Bereitstellung
  echo -e "\n${BOLD}--- Bereitstellung unter /sdcard/Download ---${RESET}"
  ls -lh "${DOWNLOAD_DIR}"/ClauDroide-*.apk 2>/dev/null || echo -e "${YELLOW}Keine APKs in /sdcard/Download gefunden.${RESET}"

  # Schnell-Check
  echo -e "\n${BOLD}--- Qualitäts-Gates ---${RESET}"
  python3 tools/sync_frontmatter.py --check
  python3 tools/secret_gate.py .
}

cmd_build() {
  local target="${1:-debug}"
  local taskName=""
  local apkSrc=""
  local apkDestName=""

  if [ "${target}" == "debug" ]; then
    taskName=":app:assembleDebug"
    apkSrc="app/build/outputs/apk/debug/app-debug.apk"
    apkDestName="ClauDroide-debug.apk"
  elif [ "${target}" == "release" ]; then
    taskName=":app:assembleRelease"
    apkSrc="app/build/outputs/apk/release/app-release.apk"
    apkDestName="ClauDroide-release.apk"
  else
    log_err "Unbekanntes Build-Ziel '${target}'. Gültig sind: debug, release."
    exit 1
  fi

  log_info "Starte Build für ${BOLD}${target}${RESET} mit A56-Speicherprofil (-Xmx1536m, 1 Worker, no-daemon)..."
  ./gradlew --no-daemon -Dorg.gradle.jvmargs="${GRADLE_JVM_ARGS}" "${taskName}"

  if [ ! -f "${apkSrc}" ]; then
    log_err "Build abgeschlossen, aber Zieldatei ${apkSrc} wurde nicht erzeugt!"
    exit 1
  fi

  local apkSize sha256
  apkSize=$(ls -lh "${apkSrc}" | awk '{print $5}')
  sha256=$(sha256sum "${apkSrc}" | awk '{print $1}')

  log_ok "Build erfolgreich: ${apkSrc} (${apkSize})"
  log_info "SHA-256: ${sha256}"

  if [ -d "${DOWNLOAD_DIR}" ]; then
    local targetPath="${DOWNLOAD_DIR}/${apkDestName}"
    local shaPath="${targetPath}.sha256"
    log_info "Kopiere nach ${targetPath}..."
    cp -f "${apkSrc}" "${targetPath}"
    echo "${sha256}  ${apkDestName}" > "${shaPath}"
    log_ok "APK bereitgestellt: ${targetPath}"
    log_ok "Prüfsumme abgelegt: ${shaPath}"
  else
    log_warn "${DOWNLOAD_DIR} nicht erreichbar — Sideload-Kopie übersprungen."
  fi
}

cmd_test() {
  local mode="${1:-fast}"

  if [ "${mode}" == "fast" ]; then
    log_info "Führe Fast-Smoke Unit-Tests aus (Theme, Security, ModelPresenter)..."
    ./gradlew --no-daemon -Dorg.gradle.jvmargs="${GRADLE_JVM_ARGS}" \
      :app:testDebugUnitTest \
      --tests "org.claudroide.app.ThemeScrimTest" \
      --tests "org.claudroide.app.feature.control.SecurityStorageTest" \
      --tests "org.claudroide.app.feature.chat.presentation.ModelSelectionPresenterTest" 2>&1
    log_ok "Fast-Tests bestanden!"
  elif [ "${mode}" == "all" ]; then
    log_warn "Achtung: Alle 2600+ Tests dauern auf dem A56 ca. 12-14 Minuten."
    log_info "Starte vollen Testlauf..."
    ./gradlew --no-daemon -Dorg.gradle.jvmargs="${GRADLE_JVM_ARGS}" :app:testDebugUnitTest
    if [ -x "tools/junit_summary.py" ]; then
      python3 tools/junit_summary.py app/build/test-results/testDebugUnitTest
    fi
    log_ok "Vollständiger Testlauf abgeschlossen!"
  else
    log_info "Führe benutzerdefinierte Tests aus: --tests '${mode}'..."
    ./gradlew --no-daemon -Dorg.gradle.jvmargs="${GRADLE_JVM_ARGS}" :app:testDebugUnitTest --tests "${mode}"
    log_ok "Test(s) '${mode}' abgeschlossen!"
  fi
}

cmd_check() {
  log_info "Prüfe Frontmatter-Konsistenz (alle 135 Tasks)..."
  python3 tools/sync_frontmatter.py --check

  log_info "Prüfe auf versehentliche Geheimnisse..."
  python3 tools/secret_gate.py .

  log_info "Prüfe Git Diff auf Whitespace-Fehler..."
  git diff --check || true

  log_ok "Alle automatischen Sicherheits- und Qualitäts-Gates grün!"
}

cmd_adb() {
  echo -e "${BOLD}=== ADB STATUS & HILFE ===${RESET}"
  adb devices -l || true

  local connected
  connected=$(adb devices | grep -v "List of" | grep "device" | wc -l | tr -d ' ')
  if [ "${connected}" -gt 0 ]; then
    log_ok "${connected} Gerät(e) autorisiert und bereit."
  else
    log_warn "Kein Gerät über ADB verbunden."
    echo -e "\n${BOLD}So verbindest du dein Samsung Galaxy A56 per Wireless Debugging:${RESET}"
    echo -e "1. In den Android-Einstellungen: ${BOLD}Entwickleroptionen -> Drahtlose Fehlersuche (Wireless Debugging)${RESET} aktivieren."
    echo -e "2. Auf 'Gerät mit Kopplungscode koppeln' tippen."
    echo -e "3. In einem Termux-Terminal eingeben:"
    echo -e "   ${GREEN}adb pair localhost:<Port-aus-Dialog> <Kopplungscode>${RESET}"
    echo -e "4. Danach verbinden mit dem Port auf der Hauptseite der Drahtlosen Fehlersuche:"
    echo -e "   ${GREEN}adb connect localhost:<Port>${RESET}"
    echo -e "5. Anschließend steht 'cdx install' und 'cdx smoke' direkt zur Verfügung!"
  fi
}

cmd_install() {
  local target="${1:-debug}"
  local apkSrc=""

  if [ "${target}" == "debug" ]; then
    apkSrc="app/build/outputs/apk/debug/app-debug.apk"
  elif [ "${target}" == "release" ]; then
    apkSrc="app/build/outputs/apk/release/app-release.apk"
  fi

  if [ ! -f "${apkSrc}" ]; then
    log_warn "APK ${apkSrc} existiert nicht. Baue zuerst..."
    cmd_build "${target}"
  fi

  local connected
  connected=$(adb devices 2>/dev/null | grep -v "List of" | grep "device" | wc -l | tr -d ' ')
  if [ "${connected}" -gt 0 ]; then
    log_info "Installiere ${apkSrc} via ADB (-r -g)..."
    adb install -r -g "${apkSrc}"
    log_ok "Installation abgeschlossen!"
  else
    log_warn "Kein ADB-Gerät verbunden. Die APK liegt bereit unter:"
    echo -e "${BOLD}${DOWNLOAD_DIR}/ClauDroide-${target}.apk${RESET}"
    echo -e "Öffne einfach deine Android 'Eigene Dateien'-App (Downloads) und tippe die APK an!"
  fi
}

cmd_clean() {
  log_info "Stoppe aktive oder hängende Gradle-Daemons..."
  ./gradlew --stop 2>/dev/null || true
  log_info "Räume temporäre Build-Reste auf..."
  rm -rf /tmp/claude-*/*.output 2>/dev/null || true
  log_ok "Bereinigung abgeschlossen."
}

cmd_resume() {
  log_info "Lese aktuellen Checkpoint aus progress/BUILD-STATE.md und CLAUDROIDE_CURRENT_STATE.md..."
  head -n 12 progress/BUILD-STATE.md
  echo ""
  cmd_check
}

# Subcommand-Dispatch
case "${1:-}" in
  status|info)
    cmd_status
    ;;
  build)
    shift
    cmd_build "${1:-debug}"
    ;;
  test)
    shift
    cmd_test "${1:-fast}"
    ;;
  check|gate)
    cmd_check
    ;;
  adb)
    cmd_adb
    ;;
  install)
    shift
    cmd_install "${1:-debug}"
    ;;
  clean)
    cmd_clean
    ;;
  resume)
    cmd_resume
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
